{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-chat-archive:schema:conversation:1.0.0",
  "title": "AIChatArchive unified conversation 1.0.0",
  "description": "Sparse human-readable Cloudig conversation JSON with unified linear/branch messages and auditable content time.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identity", "generation", "lifecycle", "source", "message_time", "content_time", "title", "provider", "platform", "messages"],
  "properties": {
    "schema": { "const": "ai-chat-archive/conversation/1.0.0" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation_key", "archive_id"],
      "properties": {
        "conversation_key": { "$ref": "#/$defs/sha256" },
        "archive_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parser_version", "parser_adapter"],
      "properties": {
        "parser_version": { "$ref": "#/$defs/semver" },
        "parser_adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
            "version": { "$ref": "#/$defs/semver" }
          }
        },
        "exporter_version": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_parsed_at", "last_parsed_at", "cloudig_edited_at"],
      "properties": {
        "first_parsed_at": { "$ref": "#/$defs/firstParsedFact" },
        "last_parsed_at": { "$ref": "#/$defs/utcDateTime" },
        "cloudig_edited_at": { "$ref": "#/$defs/utcDateTime" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "captured_at"],
      "properties": {
        "file": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "sha256", "size_bytes"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "pattern": "^[^\\\\/]+$" },
            "sha256": { "$ref": "#/$defs/sha256" },
            "size_bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "url": { "$ref": "#/$defs/httpUrl" },
        "captured_at": { "$ref": "#/$defs/capturedFact" },
        "conversation_created_at": { "$ref": "#/$defs/utcDateTime" },
        "conversation_updated_at": { "$ref": "#/$defs/utcDateTime" }
      }
    },
    "message_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamped_messages", "total_messages"],
      "properties": {
        "start": { "$ref": "#/$defs/utcDateTime" },
        "end": { "$ref": "#/$defs/utcDateTime" },
        "timestamped_messages": { "type": "integer", "minimum": 0 },
        "total_messages": { "type": "integer", "minimum": 1 }
      },
      "dependentRequired": { "start": ["end"], "end": ["start"] }
    },
    "content_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parser_default", "effective"],
      "properties": {
        "parser_default": { "$ref": "#/$defs/parserDefault" },
        "effective": { "$ref": "#/$defs/effectiveContentTime" }
      }
    },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "provider": { "$ref": "#/$defs/slug" },
    "platform": { "$ref": "#/$defs/slug" },
    "models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "conversation-0.2.5.schema.json#/$defs/message" }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "conversation-0.2.5.schema.json#/$defs/resource" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "conversation-0.2.5.schema.json#/$defs/source" }
    },
    "warnings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "conversation-0.2.5.schema.json#/$defs/warning" }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$" },
    "utcDateTime": { "type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "httpUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "firstParsedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {
        "value": { "$ref": "#/$defs/utcDateTime" },
        "basis": { "enum": ["parser_creation", "legacy_output_birthtime_estimate", "legacy_last_parse_upper_bound", "unavailable"] }
      },
      "allOf": [
        {
          "if": { "properties": { "basis": { "const": "unavailable" } }, "required": ["basis"] },
          "then": { "not": { "required": ["value"] } },
          "else": { "required": ["value"] }
        }
      ]
    },
    "capturedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {
        "value": { "$ref": "#/$defs/utcDateTime" },
        "basis": { "enum": ["bookmark_metadata", "source_metadata", "filesystem_earliest_create_or_modify", "filesystem_modified_time", "unavailable"] },
        "field": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\\\/]+$" }
      },
      "allOf": [
        {
          "if": { "properties": { "basis": { "const": "unavailable" } }, "required": ["basis"] },
          "then": { "not": { "required": ["value"] } },
          "else": { "required": ["value"] }
        }
      ]
    },
    "parserDefault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edited_at", "derivation"],
      "properties": {
        "edited_at": { "$ref": "#/$defs/utcDateTime" },
        "derivation": { "enum": ["message_start", "source_capture_fallback", "unavailable"] },
        "range": { "$ref": "../time/content-time-1.0.0.schema.json#/$defs/terranRange" }
      },
      "allOf": [
        {
          "if": { "properties": { "derivation": { "const": "unavailable" } }, "required": ["derivation"] },
          "then": { "not": { "required": ["range"] } },
          "else": { "required": ["range"] }
        }
      ]
    },
    "effectiveContentTime": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": { "source": { "const": "parser" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "state", "edit_id", "edited_at", "range"],
          "properties": {
            "source": { "const": "user" },
            "state": { "const": "set" },
            "edit_id": { "$ref": "#/$defs/uuid" },
            "edited_at": { "$ref": "#/$defs/utcDateTime" },
            "range": { "$ref": "../time/content-time-1.0.0.schema.json#/$defs/conversationRange" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "state", "edit_id", "edited_at"],
          "properties": {
            "source": { "const": "user" },
            "state": { "const": "cleared" },
            "edit_id": { "$ref": "#/$defs/uuid" },
            "edited_at": { "$ref": "#/$defs/utcDateTime" }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudig.local/schema/common/1.0.0",
  "title": "Cloudig V1 common machine-contract definitions",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "strictSemver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
    },
    "localDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
    },
    "utcOffset": {
      "type": "string",
      "pattern": "^(?:Z|[+-](?:(?:0[1-9]|1[0-3]):[0-5][0-9]|00:(?:0[1-9]|[1-5][0-9])|14:00))$"
    },
    "archiveId": {
      "type": "string",
      "pattern": "^a[1-9][0-9]*$"
    },
    "messageId": {
      "type": "string",
      "pattern": "^m[1-9][0-9]*$"
    },
    "resourceId": {
      "type": "string",
      "pattern": "^r[1-9][0-9]*$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^s[1-9][0-9]*$"
    },
    "toolId": {
      "type": "string",
      "pattern": "^x[1-9][0-9]*$"
    },
    "lineageId": {
      "type": "string",
      "pattern": "^l[1-9][0-9]*$"
    },
    "variantId": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "timeId": {
      "type": "string",
      "pattern": "^t[1-9][0-9]*$"
    },
    "presetId": {
      "type": "string",
      "pattern": "^p(?:[1-9]|1[0-7])$"
    },
    "timeNodeId": {
      "oneOf": [
        {
          "$ref": "#/$defs/variantId"
        },
        {
          "$ref": "#/$defs/timeId"
        },
        {
          "$ref": "#/$defs/presetId"
        }
      ]
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)*$",
      "maxLength": 128
    },
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "httpUrl": {
      "type": "string",
      "pattern": "^https?://[^\\s]+$",
      "maxLength": 8192
    },
    "safeBasename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\:\\u0000-\\u001F]+$"
    },
    "managedRelativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001F]).+$"
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "offset"
      ],
      "properties": {
        "date": {
          "$ref": "#/$defs/localDate"
        },
        "offset": {
          "$ref": "#/$defs/utcOffset"
        }
      }
    },
    "calendarEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "era",
        "year"
      ],
      "properties": {
        "kind": {
          "const": "calendar"
        },
        "era": {
          "enum": [
            "AD",
            "BC"
          ]
        },
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999999
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "second": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "offset": {
          "$ref": "#/$defs/utcOffset"
        }
      },
      "dependentRequired": {
        "day": [
          "month"
        ],
        "hour": [
          "month",
          "day"
        ],
        "minute": [
          "month",
          "day",
          "hour"
        ],
        "second": [
          "month",
          "day",
          "hour",
          "minute"
        ],
        "offset": [
          "month",
          "day",
          "hour"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "era": {
                "const": "BC"
              }
            },
            "required": [
              "era"
            ]
          },
          "then": {
            "properties": {
              "year": {
                "type": "integer",
                "maximum": 9999
              }
            }
          }
        }
      ]
    },
    "decadeEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "era",
        "index"
      ],
      "properties": {
        "kind": {
          "const": "decade"
        },
        "era": {
          "enum": [
            "AD",
            "BC"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999999
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "era": {
                "const": "BC"
              }
            },
            "required": [
              "era"
            ]
          },
          "then": {
            "properties": {
              "index": {
                "type": "integer",
                "maximum": 999
              }
            }
          }
        }
      ]
    },
    "centuryEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "era",
        "index"
      ],
      "properties": {
        "kind": {
          "const": "century"
        },
        "era": {
          "enum": [
            "AD",
            "BC"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "era": {
                "const": "BC"
              }
            },
            "required": [
              "era"
            ]
          },
          "then": {
            "properties": {
              "index": {
                "type": "integer",
                "maximum": 99
              }
            }
          }
        }
      ]
    },
    "relativeEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "direction",
        "unit",
        "value",
        "anchor"
      ],
      "properties": {
        "kind": {
          "const": "relative"
        },
        "direction": {
          "enum": [
            "before",
            "after"
          ]
        },
        "unit": {
          "enum": [
            "wan",
            "yi",
            "zhao",
            "jing",
            "gai",
            "zi",
            "rang",
            "gou",
            "jian",
            "zheng"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^(?:0\\.[1-9]|[1-9][0-9]{0,2}\\.[0-9]|[1-9][0-9]{3}\\.[0-9])$"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "direction": {
                "const": "before"
              }
            },
            "required": [
              "direction"
            ]
          },
          "then": {
            "properties": {
              "unit": {
                "enum": [
                  "wan",
                  "yi"
                ]
              }
            }
          }
        }
      ]
    },
    "nowEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "anchor"
      ],
      "properties": {
        "kind": {
          "const": "now"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        }
      }
    },
    "specialEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "infinite_past",
            "infinite_future",
            "unknown",
            "whenever"
          ]
        }
      }
    },
    "progressionSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "first",
        "step",
        "last"
      ],
      "properties": {
        "mode": {
          "const": "progression"
        },
        "first": {
          "type": "integer",
          "minimum": 1
        },
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "last": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "nodeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/timeNodeId"
        },
        "occurrences": {
          "$ref": "#/$defs/progressionSelector"
        }
      }
    },
    "snapshotTimeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lineage",
        "variant",
        "number",
        "revision",
        "name",
        "author"
      ],
      "properties": {
        "lineage": {
          "$ref": "#/$defs/lineageId"
        },
        "variant": {
          "$ref": "#/$defs/variantId"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "author": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "standard_name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,2})\\.(?:0|[1-9][0-9]{0,2})$"
        }
      }
    },
    "snapshotTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/timeNodeId"
        },
        "kind": {
          "enum": [
            "variant",
            "preset",
            "single",
            "periodic"
          ]
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999999
        },
        "prefix": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "unit": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "periodic"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "count"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "count"
                  ]
                },
                {
                  "required": [
                    "prefix"
                  ]
                },
                {
                  "required": [
                    "unit"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "terranEndpoint": {
      "oneOf": [
        {
          "$ref": "#/$defs/calendarEndpoint"
        },
        {
          "$ref": "#/$defs/decadeEndpoint"
        },
        {
          "$ref": "#/$defs/centuryEndpoint"
        },
        {
          "$ref": "#/$defs/relativeEndpoint"
        },
        {
          "$ref": "#/$defs/nowEndpoint"
        },
        {
          "$ref": "#/$defs/specialEndpoint"
        }
      ]
    },
    "terranRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/terranEndpoint"
        },
        "end": {
          "$ref": "#/$defs/terranEndpoint"
        }
      }
    },
    "sovereignSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeline",
        "target"
      ],
      "properties": {
        "timeline": {
          "$ref": "#/$defs/snapshotTimeline"
        },
        "target": {
          "$ref": "#/$defs/snapshotTarget"
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "sort": {
          "$ref": "#/$defs/terranRange"
        }
      }
    },
    "sovereignEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "snapshot"
      ],
      "properties": {
        "kind": {
          "const": "sovereign"
        },
        "target": {
          "$ref": "#/$defs/nodeRef"
        },
        "snapshot": {
          "$ref": "#/$defs/sovereignSnapshot"
        }
      }
    },
    "endpoint": {
      "oneOf": [
        {
          "$ref": "#/$defs/terranEndpoint"
        },
        {
          "$ref": "#/$defs/sovereignEndpoint"
        }
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/endpoint"
        },
        "end": {
          "$ref": "#/$defs/endpoint"
        }
      }
    },
    "ijsonValue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ijsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/ijsonValue"
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudig.local/schema/operation/1.0.0",
  "title": "Cloudig operation event 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "phase",
    "state"
  ],
  "properties": {
    "schema": {
      "const": "cloudig/operation/1.0.0"
    },
    "operation": {
      "type": "string",
      "pattern": "^o_[A-Z2-7]{16,52}$"
    },
    "phase": {
      "enum": [
        "discover",
        "probe",
        "fingerprint",
        "extract",
        "normalize",
        "validate",
        "plan",
        "stage",
        "commit",
        "verify"
      ]
    },
    "state": {
      "enum": [
        "started",
        "progress",
        "waiting_commit",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "file": {
      "$ref": "#/$defs/fileProgress"
    },
    "bytes": {
      "$ref": "#/$defs/knownProgress"
    },
    "items": {
      "$ref": "#/$defs/itemProgress"
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ],
  "$defs": {
    "knownProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed",
        "total"
      ],
      "properties": {
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fileProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "completed",
        "total"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "itemProgress": {
      "oneOf": [
        {
          "$ref": "#/$defs/knownProgress"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completed",
            "total_known"
          ],
          "properties": {
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "total_known": {
              "const": false
            }
          }
        }
      ]
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed",
        "limit"
      ],
      "properties": {
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "retry"
      ],
      "properties": {
        "code": {
          "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/slug"
        },
        "retry": {
          "enum": [
            "immediate",
            "after_source_change",
            "after_adapter_change",
            "after_conflict_resolution",
            "after_recovery",
            "never_for_this_version"
          ]
        },
        "path": {
          "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/jsonPointer"
        },
        "capacity": {
          "$ref": "#/$defs/capacity"
        }
      }
    }
  }
}

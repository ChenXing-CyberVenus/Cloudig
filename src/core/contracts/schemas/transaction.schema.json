{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudig.local/schema/transaction/1.0.0",
  "title": "Cloudig internal transaction journal 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "transaction",
    "state",
    "intent",
    "created_at",
    "updated_at",
    "authority",
    "targets"
  ],
  "properties": {
    "schema": {
      "const": "cloudig/transaction/1.0.0"
    },
    "transaction": {
      "type": "string",
      "pattern": "^x_[A-Z2-7]{16,52}$"
    },
    "state": {
      "enum": [
        "planned",
        "staged",
        "installing",
        "committed",
        "cleaned",
        "rolling_back",
        "rolled_back",
        "conflict"
      ]
    },
    "intent": {
      "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/slug"
    },
    "created_at": {
      "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/utcTimestamp"
    },
    "updated_at": {
      "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/utcTimestamp"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "spools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spool"
      }
    }
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/sha256"
        }
      }
    },
    "expectedBefore": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "missing"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "bytes",
            "sha256"
          ],
          "properties": {
            "state": {
              "const": "present"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/sha256"
            }
          }
        }
      ]
    },
    "authorityState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "missing"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "revision",
            "sha256"
          ],
          "properties": {
            "state": {
              "const": "present"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "bytes",
            "sha256"
          ],
          "properties": {
            "state": {
              "const": "unusable"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/sha256"
            }
          }
        }
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library"
      ],
      "properties": {
        "library": {
          "$ref": "#/$defs/authorityState"
        },
        "time": {
          "$ref": "#/$defs/authorityState"
        }
      }
    },
    "sourceFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/managedRelativePath"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/sha256"
        }
      }
    },
    "spool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "path",
        "status",
        "expected"
      ],
      "properties": {
        "resource": {
          "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/resourceId"
        },
        "path": {
          "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/managedRelativePath"
        },
        "status": {
          "enum": [
            "planned",
            "written",
            "verified",
            "cleaned",
            "conflict"
          ]
        },
        "expected": {
          "$ref": "#/$defs/fingerprint"
        },
        "observed": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    },
    "conversationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "archive",
        "generation",
        "schema"
      ],
      "properties": {
        "kind": {
          "const": "conversation"
        },
        "archive": {
          "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/archiveId"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "schema": {
          "const": "cloudig/conversation/1.0.0"
        }
      }
    },
    "simpleIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "library",
            "time_system",
            "recovery_manifest",
            "user_asset",
            "source_import",
            "archive_move",
            "markdown_export"
          ]
        }
      }
    },
    "semanticIdentity": {
      "oneOf": [
        {
          "$ref": "#/$defs/conversationIdentity"
        },
        {
          "$ref": "#/$defs/simpleIdentity"
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "path",
        "status",
        "expected_before",
        "semantic"
      ],
      "properties": {
        "action": {
          "enum": [
            "create",
            "replace",
            "move",
            "remove_generated"
          ]
        },
        "path": {
          "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/managedRelativePath"
        },
        "status": {
          "enum": [
            "planned",
            "staged",
            "displaced",
            "installed",
            "rolled_back",
            "conflict"
          ]
        },
        "expected_before": {
          "$ref": "#/$defs/expectedBefore"
        },
        "staged_after": {
          "$ref": "#/$defs/fingerprint"
        },
        "installed": {
          "$ref": "#/$defs/fingerprint"
        },
        "temp": {
          "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/managedRelativePath"
        },
        "displaced": {
          "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/managedRelativePath"
        },
        "source": {
          "$ref": "#/$defs/sourceFingerprint"
        },
        "semantic": {
          "$ref": "#/$defs/semanticIdentity"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "create",
                  "move"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "expected_before": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "missing"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "replace",
                  "remove_generated"
                ]
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "properties": {
              "expected_before": {
                "type": "object",
                "properties": {
                  "state": {
                    "const": "present"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}

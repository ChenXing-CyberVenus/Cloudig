{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudig.local/schema/system-log/1.0.0",
  "title": "Cloudig lightweight system log 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "cloudig/system-log/1.0.0"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileGroup"
      }
    }
  },
  "$defs": {
    "fileGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "recorded_at",
        "errors"
      ],
      "properties": {
        "path": {
          "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/managedRelativePath"
        },
        "recorded_at": {
          "$ref": "https://cloudig.local/schema/common/1.0.0#/$defs/utcTimestamp"
        },
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/error"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "message"
      ],
      "properties": {
        "source": {
          "enum": [
            "exporter",
            "parser",
            "canonical"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}

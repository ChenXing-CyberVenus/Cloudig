{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudig.local/records/common/1.0.0",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\u0000-\\u001f]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,2})\\.(?:0|[1-9][0-9]{0,2})$"
    },
    "offset": {
      "type": "string",
      "pattern": "^(?:Z|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))$"
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first",
        "step",
        "last"
      ],
      "properties": {
        "first": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999999
        },
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999999
        },
        "last": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999999
        }
      }
    },
    "selection": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "const": true
            }
          }
        },
        {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/progression"
        }
      ]
    },
    "kind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world",
        "subject"
      ],
      "properties": {
        "world": {
          "enum": [
            "terran",
            "sovereign"
          ]
        },
        "subject": {
          "enum": [
            "human",
            "ai",
            "other_intelligence",
            "life",
            "animistic",
            "object",
            "program",
            "meaning_work",
            "organization"
          ]
        }
      }
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "claimers"
      ],
      "properties": {
        "name": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/nameText"
        },
        "claimers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "front"
                ],
                "properties": {
                  "front": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/nameText"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "offset"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "offset": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/offset"
        }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "era",
        "year"
      ],
      "properties": {
        "kind": {
          "const": "calendar"
        },
        "era": {
          "enum": [
            "AD",
            "BC"
          ]
        },
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999999
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "second": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "offset": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/offset"
        }
      },
      "dependentRequired": {
        "day": [
          "month"
        ],
        "hour": [
          "month",
          "day"
        ],
        "minute": [
          "hour"
        ],
        "second": [
          "minute"
        ],
        "offset": [
          "month",
          "day"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "era": {
                "const": "BC"
              }
            }
          },
          "then": {
            "properties": {
              "year": {
                "type": "integer",
                "maximum": 9999
              }
            }
          }
        }
      ]
    },
    "decade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "era",
        "index"
      ],
      "properties": {
        "kind": {
          "const": "decade"
        },
        "era": {
          "enum": [
            "AD",
            "BC"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999999
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "era": {
                "const": "BC"
              }
            }
          },
          "then": {
            "properties": {
              "index": {
                "type": "integer",
                "maximum": 999
              }
            }
          }
        }
      ]
    },
    "century": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "era",
        "index"
      ],
      "properties": {
        "kind": {
          "const": "century"
        },
        "era": {
          "enum": [
            "AD",
            "BC"
          ]
        },
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "era": {
                "const": "BC"
              }
            }
          },
          "then": {
            "properties": {
              "index": {
                "type": "integer",
                "maximum": 99
              }
            }
          }
        }
      ]
    },
    "relative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "direction",
        "unit",
        "value",
        "anchor"
      ],
      "properties": {
        "kind": {
          "const": "relative"
        },
        "direction": {
          "enum": [
            "before",
            "after"
          ]
        },
        "unit": {
          "enum": [
            "wan",
            "yi",
            "zhao",
            "jing",
            "gai",
            "zi",
            "rang",
            "gou",
            "jian",
            "zheng"
          ]
        },
        "value": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,3})\\.[0-9]$"
        },
        "anchor": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/anchor"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "direction": {
                "const": "before"
              }
            }
          },
          "then": {
            "properties": {
              "unit": {
                "enum": [
                  "wan",
                  "yi"
                ]
              }
            }
          }
        }
      ]
    },
    "terran": {
      "oneOf": [
        {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/calendar"
        },
        {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/decade"
        },
        {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/century"
        },
        {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/relative"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "anchor"
          ],
          "properties": {
            "kind": {
              "const": "now"
            },
            "anchor": {
              "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/anchor"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "infinite_past",
                "infinite_future",
                "unknown",
                "whenever"
              ]
            }
          }
        }
      ]
    },
    "terranRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/terran"
        },
        "end": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/terran"
        }
      }
    },
    "snapshotNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "timeline",
            "single",
            "periodic"
          ]
        },
        "name": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/nameText"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999999
        },
        "prefix": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/nameText"
        },
        "unit": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/nameText"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "periodic"
              }
            }
          },
          "then": {
            "required": [
              "count"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "count"
                  ]
                },
                {
                  "required": [
                    "prefix"
                  ]
                },
                {
                  "required": [
                    "unit"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "snapshotTimeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "author"
      ],
      "properties": {
        "name": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/nameText"
        },
        "author": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/nameText"
        },
        "standard_name": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/nameText"
        },
        "version": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/version"
        }
      }
    },
    "nodeEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target",
        "snapshot"
      ],
      "properties": {
        "kind": {
          "const": "node"
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node"
          ],
          "properties": {
            "node": {
              "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/uuid"
            },
            "timeline": {
              "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/uuid"
            },
            "occurrences": {
              "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/progression"
            }
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node"
          ],
          "properties": {
            "node": {
              "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/snapshotNode"
            },
            "timeline": {
              "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/snapshotTimeline"
            },
            "path": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "sort": {
              "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/terranRange"
            }
          }
        }
      }
    },
    "endpoint": {
      "oneOf": [
        {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/terran"
        },
        {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/nodeEndpoint"
        }
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start"
      ],
      "properties": {
        "start": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/endpoint"
        },
        "end": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/endpoint"
        }
      }
    },
    "sourceFront": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_id",
        "names",
        "kind",
        "role"
      ],
      "properties": {
        "schema": {
          "const": "cloudig/identity/1.0.0"
        },
        "names": {
          "type": "array",
          "items": {
            "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/name"
          }
        },
        "display_name": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/kind"
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/relativePath"
        },
        "created_at": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/utc"
        },
        "edited_at": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/utc"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "enum": [
                  "tool",
                  "system"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "kind": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "world",
                  "subject"
                ],
                "properties": {
                  "world": {
                    "const": "terran"
                  },
                  "subject": {
                    "const": "program"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "modelFront": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "names",
        "display_name",
        "kind",
        "role",
        "created_at",
        "edited_at"
      ],
      "properties": {
        "schema": {
          "const": "cloudig/identity/1.0.0"
        },
        "names": {
          "type": "array",
          "items": {
            "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/name"
          },
          "minItems": 1
        },
        "display_name": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "world",
            "subject"
          ],
          "properties": {
            "world": {
              "const": "terran"
            },
            "subject": {
              "const": "ai"
            }
          }
        },
        "role": {
          "const": "assistant"
        },
        "image": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/relativePath"
        },
        "created_at": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/utc"
        },
        "edited_at": {
          "$ref": "https://cloudig.local/records/common/1.0.0#/$defs/utc"
        }
      }
    },
    "nameText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "titleText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}

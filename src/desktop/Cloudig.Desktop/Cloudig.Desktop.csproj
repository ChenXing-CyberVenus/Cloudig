<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Cloudig</AssemblyName>
    <RootNamespace>Cloudig.Desktop</RootNamespace>
    <Version>1.0.5</Version>
    <ApplicationIcon>Assets\Cloudig-Taskbar.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- All managed/native runtime files ship in app/, without extraction. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <ProjectReference Include="..\Cloudig.Desktop.Core\Cloudig.Desktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Cloudig-Taskbar.ico" />
    <Resource Include="..\..\ui\assets\reader\Waiting-Sun.gif" Link="Assets\Waiting-Sun.gif" />
  </ItemGroup>

  <ItemGroup Condition="'$(CloudigPayloadRoot)' == ''">
    <Content Include="..\..\ui\shell\**\*" Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup Condition="'$(CloudigPayloadRoot)' != ''">
    <Content Include="$(CloudigPayloadRoot)\**\*" Link="%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <Import Project="..\PortableAppHost.targets" />
</Project>

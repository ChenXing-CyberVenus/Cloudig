{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudig.local/internal/recycle/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation_id", "conversation_id", "created_at", "files"],
  "properties": {
    "schema": { "const": "cloudig/recycle/1.0.0" },
    "operation_id": { "$ref": "#/$defs/uuid" },
    "conversation_id": { "$ref": "#/$defs/uuid" },
    "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{3})?Z$" },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "path", "bytes", "sha256"],
        "properties": {
          "kind": { "enum": ["conversation", "mark"] },
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "$defs": { "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" } }
}

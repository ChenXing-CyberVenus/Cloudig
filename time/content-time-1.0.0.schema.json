{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cloudig:schema:content-time:1.0.0",
  "title": "Cloudig content-time range 1.0.0",
  "$ref": "#/$defs/range",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "captured_at", "utc_offset"],
      "properties": {
        "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "captured_at": { "$ref": "#/$defs/utcDateTime" },
        "utc_offset": { "type": "string", "pattern": "^(?:Z|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))$" }
      }
    },
    "exact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "era", "year", "month", "day"],
      "properties": {
        "kind": { "const": "terran_exact" },
        "era": { "enum": ["AD", "BC"] },
        "year": { "type": "integer", "minimum": 1, "maximum": 99999999 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 },
        "hour": { "type": "integer", "minimum": 0, "maximum": 23 },
        "minute": { "type": "integer", "minimum": 0, "maximum": 59 },
        "second": { "type": "integer", "minimum": 0, "maximum": 59 },
        "utc_offset": { "type": "string", "pattern": "^(?:Z|[+-](?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))$" }
      },
      "dependentRequired": {
        "hour": ["minute"],
        "minute": ["hour"],
        "second": ["hour", "minute"],
        "utc_offset": ["hour", "minute"]
      },
      "allOf": [
        {
          "if": { "properties": { "era": { "const": "BC" } }, "required": ["era"] },
          "then": { "properties": { "year": { "maximum": 9999 } } }
        }
      ]
    },
    "yearMonth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "era", "year"],
      "properties": {
        "kind": { "const": "terran_year_month" },
        "era": { "enum": ["AD", "BC"] },
        "year": { "type": "integer", "minimum": 1, "maximum": 99999999 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 }
      },
      "allOf": [
        {
          "if": { "properties": { "era": { "const": "BC" } }, "required": ["era"] },
          "then": { "properties": { "year": { "maximum": 9999 } } }
        }
      ]
    },
    "decade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "era", "index"],
      "properties": {
        "kind": { "const": "terran_decade" },
        "era": { "enum": ["AD", "BC"] },
        "index": { "type": "integer", "minimum": 1, "maximum": 9999999 }
      },
      "allOf": [
        {
          "if": { "properties": { "era": { "const": "BC" } }, "required": ["era"] },
          "then": { "properties": { "index": { "maximum": 999 } } }
        }
      ]
    },
    "century": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "era", "index"],
      "properties": {
        "kind": { "const": "terran_century" },
        "era": { "enum": ["AD", "BC"] },
        "index": { "type": "integer", "minimum": 1, "maximum": 999999 }
      },
      "allOf": [
        {
          "if": { "properties": { "era": { "const": "BC" } }, "required": ["era"] },
          "then": { "properties": { "index": { "maximum": 99 } } }
        }
      ]
    },
    "relative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "direction", "unit", "coefficient", "anchor"],
      "properties": {
        "kind": { "const": "terran_relative" },
        "direction": { "enum": ["before", "after"] },
        "unit": { "enum": ["wan", "yi", "zhao", "jing", "gai", "zi", "rang", "gou", "jian", "zheng"] },
        "coefficient": { "type": "string", "pattern": "^(?:0\\.[1-9]|[1-9][0-9]{0,3}\\.[0-9])$" },
        "anchor": { "$ref": "#/$defs/anchor" }
      }
    },
    "now": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "anchor"],
      "properties": {
        "kind": { "const": "terran_now" },
        "anchor": { "$ref": "#/$defs/anchor" }
      }
    },
    "bare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["infinite_past", "infinite_future", "unknown", "whenever"] }
      }
    },
    "sovereignBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "binding_id"],
      "properties": {
        "kind": { "const": "sovereign" },
        "binding_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "sovereignSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "binding_id", "snapshot"],
      "properties": {
        "kind": { "const": "sovereign" },
        "binding_id": { "$ref": "#/$defs/uuid" },
        "snapshot": { "$ref": "sovereign-time-snapshot-1.0.0.schema.json" }
      }
    },
    "terranEndpoint": {
      "oneOf": [
        { "$ref": "#/$defs/exact" },
        { "$ref": "#/$defs/yearMonth" },
        { "$ref": "#/$defs/decade" },
        { "$ref": "#/$defs/century" },
        { "$ref": "#/$defs/relative" },
        { "$ref": "#/$defs/now" },
        { "$ref": "#/$defs/bare" }
      ]
    },
    "endpoint": {
      "oneOf": [
        { "$ref": "#/$defs/terranEndpoint" },
        { "$ref": "#/$defs/sovereignBinding" }
      ]
    },
    "conversationEndpoint": {
      "oneOf": [
        { "$ref": "#/$defs/terranEndpoint" },
        { "$ref": "#/$defs/sovereignSnapshot" }
      ]
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "is_collapsed", "is_reversed"],
      "properties": {
        "start": { "$ref": "#/$defs/endpoint" },
        "end": { "$ref": "#/$defs/endpoint" },
        "is_collapsed": { "type": "boolean" },
        "is_reversed": { "type": "boolean" }
      }
    },
    "conversationRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "is_collapsed", "is_reversed"],
      "properties": {
        "start": { "$ref": "#/$defs/conversationEndpoint" },
        "end": { "$ref": "#/$defs/conversationEndpoint" },
        "is_collapsed": { "type": "boolean" },
        "is_reversed": { "type": "boolean" }
      }
    },
    "terranRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "is_collapsed", "is_reversed"],
      "properties": {
        "start": { "$ref": "#/$defs/terranEndpoint" },
        "end": { "$ref": "#/$defs/terranEndpoint" },
        "is_collapsed": { "type": "boolean" },
        "is_reversed": { "type": "boolean" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cloudig:schema:conversation-catalog:1.0.0",
  "title": "Cloudig rebuildable conversation catalog 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "source_revision", "entries"],
  "properties": {
    "format": { "const": "cloudig/conversation-catalog" },
    "version": { "const": "1.0.0" },
    "source_revision": { "$ref": "#/$defs/sha256" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "optionalSha256": { "type": "string", "pattern": "^(?:|[0-9a-f]{64})$" },
    "optionalUuid": { "type": "string", "pattern": "^(?:|[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$" },
    "optionalDateTime": {
      "oneOf": [
        { "const": "" },
        { "type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$" }
      ]
    },
    "firstParsedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {
        "value": { "type": "string", "format": "date-time" },
        "basis": { "enum": ["parser_creation", "legacy_output_birthtime_estimate", "legacy_last_parse_upper_bound", "unavailable"] }
      }
    },
    "sourceCapturedFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis"],
      "properties": {
        "value": { "type": "string", "format": "date-time" },
        "basis": { "enum": ["bookmark_metadata", "source_metadata", "filesystem_earliest_create_or_modify", "filesystem_modified_time", "legacy_exported_at", "legacy_source_time", "unavailable"] },
        "field": { "type": "string", "maxLength": 200 }
      }
    },
    "parserAdapter": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["id", "version"]
    },
    "descriptor": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["domain"],
          "properties": {
            "domain": { "enum": ["terran_ordered", "special_independent", "sovereign_unmapped", "unset_or_invalid"] },
            "segment": { "type": "integer" },
            "lower": { "type": "string", "pattern": "^-?[0-9]+$" },
            "upper": { "type": "string", "pattern": "^-?[0-9]+$" },
            "precision_rank": { "type": "integer" },
            "kind_rank": { "type": "integer" },
            "timeline_order": { "type": "integer" },
            "ordinal_path": { "type": "array" },
            "occurrence_first": { "type": "integer" },
            "occurrence_last": { "type": "integer" },
            "edited_at_desc": { "type": "string" },
            "node_id": { "type": "string" },
            "stable_tie": { "type": "array" },
            "range_tie": { "type": "array", "minItems": 3, "maxItems": 3 }
          },
          "additionalProperties": false
        }
      ]
    },
    "contentTime": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "../time/content-time-1.0.0.schema.json#/$defs/range" },
        { "$ref": "../library/cloudig-library-0.1.4.schema.json#/$defs/contentTime" }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path", "size_bytes", "modified_at", "file_created_at", "sha256",
        "conversation_key", "archive_id", "artifact_role", "title", "provider", "platform", "models",
        "content_time", "content_time_source", "content_time_state", "content_time_label_zh", "content_time_label_en",
        "content_time_binding_ids", "content_time_snapshot_sha256", "content_time_sort_descriptor",
        "first_parsed_at", "last_parsed_at", "cloudig_edited_at", "source_captured_at", "source_file",
        "message_start", "message_end", "messages", "parser_version", "parser_adapter", "exporter_version",
        "schema", "compatibility", "error_code", "error"
      ],
      "properties": {
        "relative_path": { "type": "string", "pattern": "^Conversations/.+\\.json$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "modified_at": { "type": "string", "format": "date-time" },
        "file_created_at": { "type": "string", "format": "date-time" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "conversation_key": { "$ref": "#/$defs/optionalSha256" },
        "archive_id": { "$ref": "#/$defs/optionalUuid" },
        "artifact_role": { "enum": ["current", "historical"] },
        "title": { "type": "string" },
        "provider": { "type": "string" },
        "platform": { "type": "string" },
        "models": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "content_time": { "$ref": "#/$defs/contentTime" },
        "content_time_source": { "enum": ["", "parser", "user"] },
        "content_time_state": { "enum": ["", "parser", "set", "cleared", "unavailable"] },
        "content_time_label_zh": { "type": "string" },
        "content_time_label_en": { "type": "string" },
        "content_time_binding_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "content_time_snapshot_sha256": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/sha256" } },
        "content_time_sort_descriptor": { "$ref": "#/$defs/descriptor" },
        "first_parsed_at": { "$ref": "#/$defs/firstParsedFact" },
        "last_parsed_at": { "$ref": "#/$defs/optionalDateTime" },
        "cloudig_edited_at": { "$ref": "#/$defs/optionalDateTime" },
        "source_captured_at": { "$ref": "#/$defs/sourceCapturedFact" },
        "source_file": { "type": "string" },
        "message_start": { "$ref": "#/$defs/optionalDateTime" },
        "message_end": { "$ref": "#/$defs/optionalDateTime" },
        "messages": { "type": "integer", "minimum": 0 },
        "parser_version": { "type": "string" },
        "parser_adapter": { "$ref": "#/$defs/parserAdapter" },
        "exporter_version": { "type": "string" },
        "schema": { "type": "string" },
        "compatibility": { "enum": ["supported", "unsupported", "invalid"] },
        "error_code": { "enum": ["", "invalid_json", "invalid_conversation"] },
        "error": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
